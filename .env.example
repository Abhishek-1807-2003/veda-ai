# VedaAI Environment Variables Example
# Copy this file and create your own .env files:
# - apps/backend/.env (for backend)
# - .env (for frontend / Vite)

# ── Backend (.env at apps/backend/.env) ──────────────────────────────
# PORT=4000
# NODE_ENV=development
# MONGO_URI=mongodb://localhost:27017/vedaai
# REDIS_HOST=localhost
# REDIS_PORT=6379
# JWT_SECRET=replace_with_32_char_random_string
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-your-key-here
# WS_PORT=4001

# ── Frontend (.env at project root) ──────────────────────────────────
# VITE_API_URL=http://localhost:4000/api/v1
# VITE_WS_URL=ws://localhost:4001
