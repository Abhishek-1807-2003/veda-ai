{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "node dist/index.js",
    "restartPolicy": "always",
    "healthchecks": {
      "enabled": true,
      "interval": 10,
      "timeout": 5
    }
  }
}
