{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "dockerfile": "apps/backend/Dockerfile",
    "context": "."
  },
  "deploy": {
    "startCommand": "node dist/index.js",
    "restartPolicy": "always",
    "healthchecks": {
      "enabled": true,
      "interval": 30,
      "timeout": 10
    }
  }
}
