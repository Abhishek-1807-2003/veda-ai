# Production Environment Variables for Render
# 
# Copy these variable names and values to Render's environment settings:
# 1. Go to your Render service dashboard
# 2. Click "Environment"
# 3. Add these variables (mark sensitive ones as "Secret")
#
# For variables marked [Secret], use Render's secret manager or set them
# in the service's Environment tab with sensitive flag enabled.

# ── Server Configuration ──────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Database ──────────────────────────────────────────────────────
# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URI=mongodb+srv://[USERNAME]:[PASSWORD]@[CLUSTER].mongodb.net/[DATABASE]

# ── Redis / Cache ─────────────────────────────────────────────────
# Upstash Redis URL (with TLS for production)
# Format: rediss://default:TOKEN@HOST.upstash.io:6379
# Get from: https://console.upstash.com/redis → Select DB → Copy URL
REDIS_URL=rediss://default:[TOKEN]@[HOST].upstash.io:6379

# ── JWT / Authentication ──────────────────────────────────────────
# [Secret] Generate with: openssl rand -hex 32
JWT_SECRET=[GENERATE_32_CHAR_HEX_STRING]

# ── AI Provider ───────────────────────────────────────────────────
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# [Secret] OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-[YOUR_KEY]

# ── Frontend / CORS ───────────────────────────────────────────────
# Your frontend domain for CORS
# Example: https://yourdomain.com
FRONTEND_URL=https://[YOUR_FRONTEND_DOMAIN]

# ── Optional: Alternative AI Providers ────────────────────────────
# Uncomment if using Anthropic instead of OpenAI
# ANTHROPIC_API_KEY=[YOUR_KEY]

# Uncomment if using Together AI
# TOGETHER_API_KEY=[YOUR_KEY]
